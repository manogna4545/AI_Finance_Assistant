# ============================================================
# AI Finance Assistant - Backend Environment Configuration
# ============================================================

# Flask Application Mode ('development' or 'production')
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000

# Security Keys (Generate strong 64-char random hex in production)
SECRET_KEY=replace-with-a-random-hex-string-for-session-security
JWT_SECRET_KEY=replace-with-a-random-hex-string-for-jwt-signing

# Database Connection URI
# Local Development (SQLite):
DATABASE_URL=sqlite:///finance_assistant.db
# Production (Hosted PostgreSQL on Supabase / Render / Neon):
# DATABASE_URL=postgresql+psycopg://username:password@hostname:5432/dbname

# Frontend Client Origin for CORS Security
FRONTEND_URL=http://localhost:5173

# Optional: External AI Provider Keys (Uses smart rule-based financial advisor if omitted)
# AI_API_KEY=your_gemini_or_openai_api_key_here
